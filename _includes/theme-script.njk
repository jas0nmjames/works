{# Included at the end of <body>. Copy of the button script in index.html. #}
    <!-- [claude-color-modes] Color mode button script. Runs after the page is parsed.
         Uses window.themeModes from the head script. Wires up the #theme-controls buttons,
         saves the choice, and follows live system changes until the visitor picks a mode. -->
    <script>
    (function () {
      var tm = window.themeModes, root = document.documentElement;
      var group = document.querySelector('[data-theme-modes]');
      if (!tm || !group) return; // no head script or no switcher on this page: do nothing
      var buttons = group.querySelectorAll('[data-set-mode]');
      var themeColor = document.querySelector('meta[name="theme-color"]');

      // Mark the current mode's button aria-pressed="true" (the CSS underlines it)
      // and the others "false". Also recolor the browser UI (theme-color) to match
      // the mode's --accent: orange in light, black in mono, white in dark.
      function show() {
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.setMode === root.dataset.mode));
        });
        if (themeColor) {
          var accent = getComputedStyle(root).getPropertyValue('--accent').trim();
          if (accent) themeColor.setAttribute('content', accent);
        }
      }

      // Clicking a button switches mode right away and saves it, so it wins on future visits.
      // try/catch: saving can throw when storage is blocked; the mode still switches for this page.
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          root.dataset.mode = b.dataset.setMode;
          try { localStorage.setItem(tm.KEY, b.dataset.setMode); } catch (e) {}
          show();
        });
      });

      // Until the visitor picks a mode, follow the system live
      // (e.g. the OS switches to dark at sunset, or high contrast is turned on).
      ['(prefers-color-scheme: dark)', '(prefers-contrast: more)', '(forced-colors: active)']
        .forEach(function (q) {
          window.matchMedia(q).addEventListener('change', function () {
            if (!tm.saved()) { root.dataset.mode = tm.system(); show(); }
          });
        });

      group.hidden = false; // JS works, so reveal the switcher
      show();
    })();
    </script>
    <!-- [/claude-color-modes] -->
