---
title: anecdote
---
<!DOCTYPE html>
<html
    lang="en-US"
    dir="ltr"
    translate="yes">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jason's Portfolio</title>
    {# Color mode head script: must stay inline and above the stylesheet so the right mode paints first. #}
    {% include "theme-head.njk" %}
    <meta name="theme-color" content="#E05B08" />
    {# Absolute path: this layout renders at many URL depths. Stylesheet is copied through by eleventy.config.js. #}
    <link rel="stylesheet" href="/template-anecdote/styles.css">
    <link rel="icon" type="image/x-icon" href="/favicon_jason-james.png">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Bungee+Hairline&family=Bungee+Inline&family=Bungee+Outline&family=Bungee+Shade&family=Readex+Pro:wght@160..700&display=swap" rel="stylesheet">

    <!-- Programmatically Generated Bungee Font-->
    <link rel="stylesheet" href="https://bungee-project.djr.com/resources/web/bungee.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <script src="https://bungee-project.djr.com/resources/web/bungee.js"></script>

    <!-- Reference Bungee Font here: https://djr.com/bungee?text=Securing+UX+Training+for+the+Team&orientation=horizontal&regular=ffffffff&inline=E05B08&outline=E05B08&shade=000000&sign=E05B08&background=C4C6E2&begin=&end=&block=#tester -->

    <!-- Font Awesome Kit "jasonjames" -->
    <script src="https://kit.fontawesome.com/0e27cadf60.js" crossorigin="anonymous"></script>

</head>
<body>
    <header>
        <a href="/" title="go back to the homepage">
            <h1>jasonjames.works</h1>
        </a>
        {# Full color-mode switcher (light / black & white / dark); same markup and behavior as the homepage. #}
        {% include "theme-controls.njk" %}
    </header>
    <main>
        <article>
            <header>
                <nav class="crumbs">
                    <ol>
                        <li class="crumb">
                            <i class="fa-solid fa-up-left icon"></i> 
                            <a href="/collections/anecdotes/">anecdotes</a>
                        </li>
                    </ol>
                </nav>
                {# Accessible title for screen readers; the multilayer h2 below is aria-hidden. Was hardcoded to one anecdote. #}
                <h2 class="hidden" style="content-visibility: hidden;">{{ title }}</h2>
                <h2 class="multilayer" aria-hidden="true">
                    <span class="bungee-layers-inline">{{ title }}
                    </span>
                    <span class="bungee-layers-regular">{{ title }}
                    </span>
                    <span class="bungee-layers-outline">{{ title }}
                    </span>
                    <span class="bungee-layers-shade">{{ title }}
                    </span>
                </h2>
                {# Use page.date (not front-matter `date`): eleventy.config.js parses it as Eastern Time, and the filters format it in Eastern. #}
                <p id="article-date"><time datetime="{{ page.date | isoDate }}">{{ page.date | displayDate }}</time>{#- TV icon jumps to the video, so only show it when this anecdote has one. #}
                {%- if video %} <a href="#video-summary" aria-label="Jump to video summary"><i class="fa-regular fa-tv-retro icon"></i></a>{% endif %}</p>
                {# Tags come from front matter (they must be a YAML list, not a single string). "anecdote" is only the collection marker, so it is not shown. Links are placeholders until tag pages exist. #}
                <ul class="tag-list">
                    {%- for tag in tags %}{% if tag != "anecdote" %}
                    <li><a href="">{{ tag }}</a></li>
                    {%- endif %}{% endfor %}
                </ul>
            </header>
            {#- Summary and outcomes are optional: an anecdote without them skips the whole boxed section instead of showing an empty frame. #}
            {%- if summary %}
            <section id="summary">
                <div class="typography-label-container">
                    <h2 class="typography-label">Summary</h2>
                </div>
                {# `summary` comes from front matter #}
                <p>{{ summary }}</p>
            </section>
            {%- endif %}
            <section id="article-body">
                {# `content` is the rendered markdown body of the anecdote; `safe` stops it being HTML-escaped. #}
                {{ content | safe }}
            </section>
            {%- if outcomes %}
            <section id="outcomes">
                <div class="typography-label-container">
                    <h2 class="typography-label">Outcomes</h2>
                </div>
                {# `outcomes` is a YAML list in front matter; one <li> per entry. #}
                <ul>
                    {%- for outcome in outcomes %}
                    <li>{{ outcome }}</li>
                    {%- endfor %}
                </ul>
            </section>
            {%- endif %}
            {#- Optional: the section only renders when the anecdote sets a `video:` block in front matter
                (src, plus optional captions / subtitles_es). Files live in assets/anecdotes/<slug>/. #}
            {%- if video %}
            <section id="video-summary">
                <div class="typography-label-container">
                    <h2 class="typography-label">Video Summary</h2>
                </div>
                <video
                    controls
                    preload="metadata"
                    autoplay
                    loop
                    muted>
                    <source src="{{ video.src }}">
                    {%- if video.captions %}
                    <track label="English" kind="captions" srclang="en" src="{{ video.captions }}" default />
                    {%- endif %}
                    {%- if video.subtitles_es %}
                    <track label="Español" kind="subtitles" srclang="es" src="{{ video.subtitles_es }}" />
                    {%- endif %}
                    Your browser cannot play this video.
                </video>
            </section>
            {%- endif %}
        </article>
    </main>
    {# Button script for the switcher above; needs window.themeModes from the head script. #}
    {% include "theme-script.njk" %}
</body>
</html>